{
  "name": "laplace-chatterbox-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/chatterbox dev",
    "build": "bun run --cwd apps/chatterbox build",
    "dev:server": "bun run --cwd apps/kakashi-server dev",
    "build:server": "bun run --cwd apps/kakashi-server build",
    "lint": "biome check",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun test",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3"
  }
}
